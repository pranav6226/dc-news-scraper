# Slack Incoming Webhook (required for CI; optional locally — digest still written)
SLACK_WEBHOOK_URL=

# Company list + feed manifest (defaults under data/). After editing the CSV, run:
#   python scripts/generate_company_feeds.py
COMPANIES_CSV=data/dc_companies.csv
COMPANY_FEEDS_JSON=data/company_feeds.json

# Optional: append extra Atom/RSS URLs. When FEED_URLS is non-empty, KEYWORDS is required.
# FEED_URLS=

# KEYWORDS optional if the manifest is non-empty:
# - Trusted status/IR feeds (no ``official_only`` or ``official_only: true``) waive KEYWORDS.
# - Google News rows (``official_only: false``) require an operator-name match in title/summary.
KEYWORDS=

# Trusted hosts bypass KEYWORDS only when OUTAGE_SIGNALS is set (legacy trade-press hook).
TOPIC_RELAX_HOSTS=

# Recommended: outage / incident wording in title or summary (filters benign IR noise and most Google headlines).
OUTAGE_SIGNALS="outage,downtime,service disruption,service degradation,incident,degradation,degraded,unavailable,unavailability,failure,failed,power outage,cooling failure,error rate,error rates,partial outage,region unavailable,fire,flood,blackout,evacuat,explosion,water leak,data hall"

REQUIRE_SLACK_WEBHOOK=false
