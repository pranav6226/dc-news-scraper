# Slack Incoming Webhook (required for CI; optional locally — digest still written)
SLACK_WEBHOOK_URL=

# Optional: NewsAPI — if unset, only RSS is used
NEWSAPI_KEY=

# Comma-separated RSS/Atom URLs (DCD + hyperscaler/other status pages)
FEED_URLS=https://www.datacenterdynamics.com/en/rss/,https://status.aws.amazon.com/rss/all.rss,https://azure.status.microsoft/status/feed/

# Topic / scope — cloud brands, DC operators, neutral facility language (pairs with TOPIC_RELAX_HOSTS + DCD for colo outages)
# (Quote for `set -a && source .env` — values contain spaces/commas.)
KEYWORDS="data center,datacenter,colocation,colo,data centre,facility,hyperscale,AWS,GCP,Google Cloud,Microsoft Azure,Azure,Oracle Cloud,IBM Cloud,OVHcloud,Cloudflare,Equinix,Digital Realty,CoreSite,CyrusOne,QTS Realty,Vantage Data Centers,Scala Data Centers,STACK Infrastructure,NTT,NTT DATA"

# Trusted hosts: skip KEYWORDS *only when* OUTAGE_SIGNALS is non-empty and the article passes the outage-word gate — lets DCD run facility/colo outages that never say “AWS”
TOPIC_RELAX_HOSTS=datacenterdynamics.com

# Required in title+summary IN ADDITION to topic — cuts generic DC headlines
OUTAGE_SIGNALS="outage,downtime,service disruption,service degradation,incident,degradation,degraded,unavailable,unavailability,failure,failed,power outage,cooling failure,error rate,error rates,partial outage,region unavailable,fire,flood,blackout,evacuat,explosion,water leak,data hall"

# NewsAPI — cast a wide infra net (not hyperscaler-centric)
NEWSAPI_QUERY="(outage OR downtime OR \"service disruption\" OR degradation OR incident OR unavailable OR failure OR fire OR blackout OR evacuation OR flood) AND (\"data center\" OR datacenter OR \"data centre\" OR colocation OR colo OR facility OR hyperscale OR cloud OR AWS OR Azure OR GCP OR \"Google Cloud\" OR Equinix OR \"Digital Realty\" OR CoreSite OR OVHcloud)"

LOOKBACK_HOURS=48
NEWSAPI_PAGE_SIZE=40
REQUIRE_SLACK_WEBHOOK=false
