# Slack Incoming Webhook (required for CI; optional locally — digest still written)
SLACK_WEBHOOK_URL=

# Optional: NewsAPI — if unset, only RSS is used
NEWSAPI_KEY=

# Comma-separated RSS/Atom URLs — industry news + cloud/colo/CDN/status pages (Statuspage-style Atom is fine)
FEED_URLS="https://www.datacenterdynamics.com/en/rss/,https://status.aws.amazon.com/rss/all.rss,https://azure.status.microsoft/status/feed/,https://status.digitalrealty.com/history.atom,https://status.databank.com/history.atom,https://status.equinixmetal.com/history.atom,https://status.ovhcloud.com/history.atom,https://status.akamai.com/history.atom,https://status.digitalocean.com/history.atom,https://status.linode.com/history.atom,https://status.scaleway.com/history.atom,https://www.ibm.com/cloud/status/api/notifications/v1/rss,https://status.snowflake.com/history.atom,https://metastatuspage.com/history.atom"
# Optional (SaaS / very chatty POP maintenance — uncomment and append to FEED_URLS if you want them):
# https://www.githubstatus.com/history.atom https://status.twilio.com/history.atom https://status.salesforce.com/history.atom https://www.cloudflarestatus.com/history.atom

# Topic / scope — cloud brands, colo operators, neutral DC terms (pairs with TOPIC_RELAX_HOSTS + DCD)
# (Quote for `set -a && source .env` — values contain spaces/commas.)
KEYWORDS="data center,datacenter,colocation,colo,data centre,hyperscale,AWS,GCP,Google Cloud,Microsoft Azure,Azure,Oracle Cloud,IBM Cloud,OVHcloud,Cloudflare,Equinix,Equinix Metal,Digital Realty,DataBank,CoreSite,CyrusOne,QTS Realty,Vantage Data Centers,Scala Data Centers,STACK Infrastructure,NTT,NTT DATA,Akamai,DigitalOcean,Linode,Scaleway,Snowflake,Meta"

# Trusted hosts: skip KEYWORDS *only when* OUTAGE_SIGNALS is non-empty and the article passes the outage-word gate — lets DCD run facility/colo outages that never say “AWS”
TOPIC_RELAX_HOSTS=datacenterdynamics.com

# Required in title+summary IN ADDITION to topic — cuts generic DC headlines
OUTAGE_SIGNALS="outage,downtime,service disruption,service degradation,incident,degradation,degraded,unavailable,unavailability,failure,failed,power outage,cooling failure,error rate,error rates,partial outage,region unavailable,fire,flood,blackout,evacuat,explosion,water leak,data hall"

# NewsAPI — second gate in code (NEWSAPI_ANCHORS) removes random facility fires / evacuations
NEWSAPI_ANCHORS="data center,datacenter,data centre,colocation,colo,hyperscale,public cloud,cloud computing,cloud provider,cloud region,availability zone,internet exchange,hosted infrastructure,edge data center,AWS,GCP,Google Cloud,Microsoft Azure,Azure,Oracle Cloud,IBM Cloud,OVHcloud,Equinix,Equinix Metal,Digital Realty,DataBank,CoreSite,CyrusOne,QTS Realty,Akamai,DigitalOcean,Linode,Scaleway,Snowflake,Meta,Cloudflare"

# NewsAPI — cast a wide infra net; avoid bare “facility” / “cloud” (matches weather and factories)
NEWSAPI_QUERY="(outage OR downtime OR \"service disruption\" OR degradation OR incident OR unavailable OR failure OR fire OR blackout OR evacuation OR flood) AND (\"data center\" OR datacenter OR \"data centre\" OR colocation OR colo OR hyperscale OR \"public cloud\" OR \"cloud computing\" OR \"cloud provider\" OR \"cloud region\" OR \"availability zone\" OR AWS OR Azure OR GCP OR \"Google Cloud\" OR Equinix OR \"Equinix Metal\" OR \"Digital Realty\" OR DataBank OR CoreSite OR Akamai OR OVHcloud OR \"DigitalOcean\" OR Linode OR Scaleway OR Snowflake OR Meta OR IBM)"

LOOKBACK_HOURS=48
NEWSAPI_PAGE_SIZE=40
REQUIRE_SLACK_WEBHOOK=false
