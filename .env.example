# Slack Incoming Webhook (required for CI; optional locally — digest still written)
SLACK_WEBHOOK_URL=

# Optional: NewsAPI — if unset, only RSS is used
NEWSAPI_KEY=

# Comma-separated RSS/Atom feed URLs
FEED_URLS=https://www.datacenterdynamics.com/en/rss/,https://status.aws.amazon.com/rss/all.rss

# Topic / scope: provider or DC-industry terms (avoid *only* vague terms like "news")
KEYWORDS=AWS,Azure,Google Cloud,Equinix,Digital Realty,data center,datacenter,colocation

# Required in title+summary IN ADDITION to KEYWORDS — cuts "generic DC news"
# Leave empty to disable (keyword-only mode, noisier).
OUTAGE_SIGNALS=outage,downtime,service disruption,service degradation,incident,degradation,degraded,unavailable,unavailability,failure,power outage,cooling failure,error rate,error rates,partial outage,region unavailable

# NewsAPI /v2/everything — prefer problem words first, then AND infra scope
NEWSAPI_QUERY=(outage OR downtime OR "service disruption" OR degradation OR incident OR unavailable OR failure) AND ("data center" OR datacenter OR colocation OR AWS OR Azure OR Equinix)

LOOKBACK_HOURS=48
NEWSAPI_PAGE_SIZE=40
REQUIRE_SLACK_WEBHOOK=false
