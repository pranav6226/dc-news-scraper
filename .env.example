# Slack Incoming Webhook (required for CI; optional locally — digest still written)
# Get a URL from Slack: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional: NewsAPI (https://newsapi.org/) — if unset, only RSS is used
NEWSAPI_KEY=

# Comma-separated RSS/Atom feed URLs
FEED_URLS=https://www.datacenterdynamics.com/en/rss/,https://status.aws.amazon.com/rss/all.rss

# Comma-separated phrases; any match in title or summary counts
KEYWORDS=aws outage,azure outage,google cloud outage,equinix outage,digital realty outage,power outage,cooling failure,outage,downtime,incident

# NewsAPI /v2/everything query (used only if NEWSAPI_KEY is set)
NEWSAPI_QUERY="data center" AND (outage OR downtime OR incident OR failure)

# How far back to search NewsAPI (hours)
LOOKBACK_HOURS=48

# Max articles from NewsAPI per run
NEWSAPI_PAGE_SIZE=40

# Fail the process if Slack webhook is missing (set true in CI step or export locally)
REQUIRE_SLACK_WEBHOOK=false
